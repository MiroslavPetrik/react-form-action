{
  "name": "react-form-action",
  "version": "2.19.0",
  "description": "State management helpers for the react form actions.",
  "repository": {
    "type": "git",
    "url": "https://github.com/MiroslavPetrik/react-form-action.git"
  },
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "files": [
    "/dist"
  ],
  "scripts": {
    "build": "tsdown src/index.ts src/client.ts --minify",
    "test": "vitest",
    "typecheck": "vitest --typecheck",
    "lint": "biome lint ./src",
    "lint:write": "biome lint ./src --write",
    "format": "biome format --write .",
    "format:check": "biome check .",
    "check-updates": "ncu --interactive --format group",
    "pub:next": "npm publish --tag next"
  },
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "module": "./dist/index.mjs",
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./client": {
      "import": "./dist/client.mjs",
      "module": "./dist/client.mjs",
      "types": "./dist/client.d.mts",
      "default": "./dist/client.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "react",
    "form-action",
    "react-form-action",
    "next",
    "next-form-action",
    "nextjs",
    "server-action"
  ],
  "author": "Miroslav Petrik",
  "license": "MIT",
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19",
    "zod": "^3.25.0 || ^4.0.0",
    "zod-form-data": "^3.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "happy-dom": "^21.0.4",
    "npm-check-updates": "^23.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsdown": "^0.23.7",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "zod": "^4.6.7",
    "zod-form-data": "^3.0.4"
  }
}
